HOST=127.0.0.1
PORT=3210
DATA_DIR=./data
ARCHIVE_ENABLED=true
APIBAY_ENABLED=true
NAME_RESOLVER_ENABLED=true
# Optional HTTP proxy for external sources. Local addresses bypass it.
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,::1
# Optional Prowlarr / Jackett Torznab endpoint; keep API keys server-side.
# TORZNAB_URL=http://127.0.0.1:9696/1/api
# TORZNAB_API_KEY=
# TORZNAB_NAME=我的索引器
# Optional compose.jackett.yaml: copy API key from your local Jackett UI after setup.
# JACKETT_API_KEY=
# CONTAINER_HTTPS_PROXY=http://host.docker.internal:7890
# CONTAINER_HTTP_PROXY=http://host.docker.internal:7890
